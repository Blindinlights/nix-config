  "buffer_font_family": "Source Code Pro",
  "theme": {
    "mode": "system",
    "light": "One Dark Pro",
    "dark": "One Dark Pro"
  },
  "icon_theme": {
    "mode": "system",
    "dark": "Colored Zed Icons Theme Dark",
